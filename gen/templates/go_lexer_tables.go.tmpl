{{- template "header" . -}}
package {{short_pkg .Options.Package}}

const tmNumClasses = {{.Lexer.Tables.NumSymbols}}

{{$runeType := bits .Lexer.Tables.NumSymbols -}}
{{if gt .Lexer.Tables.LastMapEntry.Start 2048 -}}
type mapRange struct {
	lo         rune
	hi         rune
	defaultVal uint{{$runeType}}
	val        []uint{{$runeType}}
}

func mapRune(c rune) int {
	lo := 0
	hi := len(tmRuneRanges)
	for lo < hi {
		m := lo + (hi-lo)/2
		r := tmRuneRanges[m]
		if c < r.lo {
			hi = m
		} else if c >= r.hi {
			lo = m + 1
		} else {
			i := int(c - r.lo)
			if i < len(r.val) {
				return int(r.val[i])
			}
			return int(r.defaultVal)
		}
	}
	return {{.Lexer.Tables.LastMapEntry.Target}}
}

// Latin-1 characters.
var tmRuneClass = [...]uint{{$runeType}}{
{{- int_array (.Lexer.Tables.SymbolArr 256) "\t" 79 -}}
}

const tmRuneClassLen = 256
const tmFirstRule = {{.Lexer.Tables.ActionStart}}

var tmRuneRanges = [...]mapRange{
{{range .Lexer.Tables.CompressedMap 256}}	{ {{- .Lo}}, {{.Hi}}, {{.DefaultVal}}, {{if .Vals}}[]uint{{$runeType}}{
{{- int_array .Vals "\t\t" 78}}	}{{else}}nil{{end -}} },
{{end -}}
}

{{else -}}
{{ $runeArr := .Lexer.Tables.SymbolArr 0 -}}
var tmRuneClass = [...]uint{{$runeType}}{
{{- int_array $runeArr "\t" 79 -}}
}

const tmRuneClassLen = {{len $runeArr}}
const tmFirstRule = {{.Lexer.Tables.ActionStart}}

{{end -}}
{{ if gt (len .Lexer.StartConditions) 1 -}}
// tmStateMap maps start conditions to rows of tmLexerAction.
var tmStateMap = [...]int{
{{- int_array (.Lexer.Tables.StateMapRows .Lexer.Tables.NumSymbols) "\t" 79 -}}
}

{{end -}}
{{if .Lexer.RuleToken -}}
var tmToken = [...]{{template "tokenType" .}}{
{{- int_array .Lexer.RuleToken "\t" 79 -}}
}

{{end -}}
{{ $dfa := .Lexer.Tables.DfaRows .Lexer.Tables.NumSymbols -}}
// tmLexerAction is the DFA transition table. Rows are indexed by state*tmNumClasses and
// hold either the next row (>= 0) or an action (<= tmFirstRule, or a backtracking
// checkpoint in between).
var tmLexerAction = [...]int{{bits_per_element $dfa}}{
{{- int_array $dfa "\t" 79 -}}
}

{{- if .Lexer.Tables.Backtrack}}

var tmBacktracking = [...]int{
{{- range .Lexer.Tables.Backtrack}}
	{{.Action}}, {{mul .NextState $.Lexer.Tables.NumSymbols}},{{if .Details}} // {{.Details}}{{end}}
{{- end}}
}
{{- end}}