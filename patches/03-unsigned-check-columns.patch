+// checkType returns the narrowest Go integer type for a "check" column of a packed table.
+// Keys are non-negative, so an unsigned type is used and the "unused" marker (-1) is
+// represented by the maximum value of the type, which no key can take.
+func checkType(arr []int) string {
+	max := 0
+	for _, v := range arr {
+		if v > max {
+			max = v
+		}
+	}
+	switch {
+	case max < 255:
+		return "uint8"
+	case max < 65535:
+		return "uint16"
+	}
+	return "int32"
+}
+
+// checkValues returns a check column with the "unused" marker rewritten for checkType.
+func checkValues(arr []int) []int {
+	unused := map[string]int{"uint8": 255, "uint16": 65535, "int32": -1}[checkType(arr)]
+	ret := make([]int, len(arr))
+	for i, v := range arr {
+		if v < 0 {
+			v = unused
+		}
+		ret[i] = v
+	}
+	return ret
+}
