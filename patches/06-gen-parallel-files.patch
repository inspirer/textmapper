+// AlignGo expands the "\v" column separators emitted by pre-formatted templates,
+// using the very same text/tabwriter configuration that gofmt uses. Together with
+// templates that lay out everything else canonically this produces byte-identical
+// output to FormatGo, at a small fraction of the cost (go/printer spends most of
+// its time measuring the size of every element of a large composite literal).
+//
+// go/printer terminates a run of aligned lines with a form feed when an element is
+// much wider than the ones before it (see exprList in go/printer/nodes.go), so
+// alignGoBreaks replicates that decision before handing the text to the tabwriter.
+func AlignGo(src string) string {
+	if !strings.ContainsRune(src, '\v') {
+		return src
+	}
+	var buf bytes.Buffer
+	buf.Grow(len(src) + len(src)/16)
+	// Note: these are printer.Config{Mode: UseSpaces | TabIndent, Tabwidth: 8} settings.
+	tw := tabwriter.NewWriter(&buf, 0, 8, 1, ' ', tabwriter.DiscardEmptyColumns|tabwriter.TabIndent)
+	tw.Write([]byte(alignGoBreaks(src)))
+	tw.Flush()
+	return buf.String()
+}
+
+// alignGoBreaks replaces the newline that terminates an aligned line with a form
+// feed wherever go/printer would have started a new alignment section. Each
+// "\v"-containing line is one element of a composite literal; the size that drives
+// the decision is the width of the element (or, for "key:\vvalue" pairs, of the key),
+// which is exactly the first cell minus its trailing "," or ":".
+func alignGoBreaks(src string) string {
+	var b strings.Builder
+	b.Grow(len(src))
+
+	trailingNL := strings.HasSuffix(src, "\n")
+	src = strings.TrimSuffix(src, "\n")
+
+	var prevSize, count int
+	var lnsum float64
+	var pending bool // the previous line was an aligned element awaiting its terminator
+
+	for len(src) > 0 {
+		var ln string
+		if i := strings.IndexByte(src, '\n'); i >= 0 {
+			ln, src = src[:i], src[i+1:]
+		} else {
+			ln, src = src, ""
+		}
+		vt := strings.IndexByte(ln, '\v')
+		if vt < 0 {
+			// Not part of an aligned run: the tabwriter ends the block here anyway.
+			if pending {
+				b.WriteByte('\n')
+			}
+			b.WriteString(ln)
+			if len(src) > 0 {
+				b.WriteByte('\n')
+			}
+			pending = false
+			prevSize, count, lnsum = 0, 0, 0
+			continue
+		}
+		size := len(strings.TrimLeft(ln[:vt], "\t")) - 1 // drop the trailing "," or ":"
+		if size < 1 {
+			size = 1
+		}
+		if pending {
+			useFF := true
+			if prevSize > 0 {
+				const smallSize = 40
+				if count == 0 || prevSize <= smallSize && size <= smallSize {
+					useFF = false
+				} else {
+					const r = 2.5 // threshold
+					geomean := math.Exp(lnsum / float64(count))
+					ratio := float64(size) / geomean
+					useFF = r*ratio <= 1 || r <= ratio
+				}
+			}
+			if useFF {
+				b.WriteByte('\f')
+			} else {
+				b.WriteByte('\n')
+			}
+		}
+		b.WriteString(ln)
+		pending = true
+		prevSize = size
+		lnsum += math.Log(float64(size))
+		count++
+	}
+	if trailingNL {
+		b.WriteByte('\n')
+	}
+	return b.String()
+}
